<?xml version="1.0" encoding="utf-8"?>
<!-- Sơ đồ điều hướng NutriScan: 4 module (Auth & Profile / AI Label Scan / Barcode / Recipes) -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <!-- ===== Module 3.1: Authentication & Health Profile ===== -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="vn.edu.vlu.milestone2.ui.auth.LoginFragment"
        android:label="@string/login_title">
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="vn.edu.vlu.milestone2.ui.auth.RegisterFragment"
        android:label="@string/register_title">
        <action
            android:id="@+id/action_register_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="vn.edu.vlu.milestone2.ui.profile.HealthProfileFragment"
        android:label="@string/profile_title" />

    <!-- ===== Trang chủ ===== -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="vn.edu.vlu.milestone2.ui.home.HomeFragment"
        android:label="@string/app_name">
        <action
            android:id="@+id/action_home_to_barcode"
            app:destination="@id/barcodeScannerFragment" />
        <action
            android:id="@+id/action_home_to_label_camera"
            app:destination="@id/labelCameraFragment" />
        <action
            android:id="@+id/action_home_to_analysis"
            app:destination="@id/analysisResultFragment" />
    </fragment>

    <!-- ===== Module 3.3: Barcode Scan & Product Lookup ===== -->
    <fragment
        android:id="@+id/scanHubFragment"
        android:name="vn.edu.vlu.milestone2.ui.scan.ScanHubFragment"
        android:label="@string/scan_hub_title">
        <action
            android:id="@+id/action_scan_hub_to_barcode"
            app:destination="@id/barcodeScannerFragment" />
        <action
            android:id="@+id/action_scan_hub_to_label_camera"
            app:destination="@id/labelCameraFragment" />
        <action
            android:id="@+id/action_scan_hub_to_product_detail"
            app:destination="@id/productDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/barcodeScannerFragment"
        android:name="vn.edu.vlu.milestone2.ui.scan.BarcodeScannerFragment"
        android:label="@string/barcode_title">
        <action
            android:id="@+id/action_barcode_to_product_detail"
            app:destination="@id/productDetailFragment"
            app:popUpTo="@id/barcodeScannerFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/productDetailFragment"
        android:name="vn.edu.vlu.milestone2.ui.product.ProductDetailFragment"
        android:label="@string/product_detail_title">
        <argument
            android:name="barcode"
            app:argType="string" />
        <action
            android:id="@+id/action_product_to_analysis"
            app:destination="@id/analysisResultFragment" />
        <action
            android:id="@+id/action_product_to_label_camera"
            app:destination="@id/labelCameraFragment" />
        <action
            android:id="@+id/action_product_to_recipes"
            app:destination="@id/recipesFragment" />
    </fragment>

    <fragment
        android:id="@+id/favoritesFragment"
        android:name="vn.edu.vlu.milestone2.ui.product.FavoritesFragment"
        android:label="@string/favorites_title">
        <action
            android:id="@+id/action_favorites_to_product_detail"
            app:destination="@id/productDetailFragment" />
    </fragment>

    <!-- ===== Module 3.2: AI Label Scan & Analysis ===== -->
    <fragment
        android:id="@+id/labelCameraFragment"
        android:name="vn.edu.vlu.milestone2.ui.camera.LabelCameraFragment"
        android:label="@string/camera_title">
        <action
            android:id="@+id/action_camera_to_analysis"
            app:destination="@id/analysisResultFragment"
            app:popUpTo="@id/labelCameraFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/analysisResultFragment"
        android:name="vn.edu.vlu.milestone2.ui.analysis.AnalysisResultFragment"
        android:label="@string/analysis_title">
        <argument
            android:name="scanId"
            app:argType="long" />
        <action
            android:id="@+id/action_analysis_to_recipes"
            app:destination="@id/recipesFragment" />
        <action
            android:id="@+id/action_analysis_to_product_detail"
            app:destination="@id/productDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/historyFragment"
        android:name="vn.edu.vlu.milestone2.ui.history.ScanHistoryFragment"
        android:label="@string/history_title">
        <action
            android:id="@+id/action_history_to_analysis"
            app:destination="@id/analysisResultFragment" />
        <action
            android:id="@+id/action_history_to_favorites"
            app:destination="@id/favoritesFragment" />
        <action
            android:id="@+id/action_history_to_recipes"
            app:destination="@id/recipesFragment" />
    </fragment>

    <!-- ===== Module 3.4: Healthy Recipes & Cooking Guide ===== -->
    <fragment
        android:id="@+id/recipesFragment"
        android:name="vn.edu.vlu.milestone2.ui.recipe.RecipesFragment"
        android:label="@string/recipes_title">
        <!-- Mở từ kết quả quét: "Nấu với sản phẩm vừa quét" (-1 = không có) -->
        <argument
            android:name="focusScanId"
            android:defaultValue="-1L"
            app:argType="long" />
        <action
            android:id="@+id/action_recipes_to_detail"
            app:destination="@id/recipeDetailFragment" />
        <action
            android:id="@+id/action_recipes_to_add_edit"
            app:destination="@id/addEditRecipeFragment" />
    </fragment>

    <fragment
        android:id="@+id/recipeDetailFragment"
        android:name="vn.edu.vlu.milestone2.ui.recipe.RecipeDetailFragment"
        android:label="@string/recipe_detail_title">
        <argument
            android:name="recipeId"
            app:argType="string" />
        <action
            android:id="@+id/action_recipe_detail_to_cooking"
            app:destination="@id/cookingModeFragment" />
        <action
            android:id="@+id/action_recipe_detail_to_edit"
            app:destination="@id/addEditRecipeFragment" />
    </fragment>

    <fragment
        android:id="@+id/cookingModeFragment"
        android:name="vn.edu.vlu.milestone2.ui.recipe.CookingModeFragment"
        android:label="@string/cooking_title">
        <argument
            android:name="recipeId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/addEditRecipeFragment"
        android:name="vn.edu.vlu.milestone2.ui.recipe.AddEditRecipeFragment"
        android:label="@string/add_edit_recipe_title">
        <argument
            android:name="recipeId"
            android:defaultValue=""
            app:argType="string" />
    </fragment>

</navigation>
