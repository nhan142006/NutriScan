<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

firebase-authentication
    <fragment
        android:id="@+id/loginFragment"
        android:name="vn.edu.vlu.milestone2.ui.auth.LoginFragment"
        android:label="@string/login_title" />

    <!-- Milestone 04: Firebase Authentication -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="vn.edu.vlu.milestone2.ui.auth.LoginFragment"
        android:label="Đăng nhập">
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/healthProfileFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>
main

    <fragment
        android:id="@+id/registerFragment"
        android:name="vn.edu.vlu.milestone2.ui.auth.RegisterFragment"
firebase-authentication
        android:label="@string/register_title" />

        android:label="Đăng ký">
        <action
            android:id="@+id/action_register_to_home"
            app:destination="@id/healthProfileFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>
main

    <fragment
        android:id="@+id/healthProfileFragment"
        android:name="vn.edu.vlu.milestone2.ui.profile.HealthProfileFragment"
        android:label="Hồ sơ" />

    <fragment
        android:id="@+id/scannerFragment"
        android:name="vn.edu.vlu.milestone2.ui.scanner.ScannerFragment"
        android:label="Tra cứu">
        <action
            android:id="@+id/action_scanner_to_analysis"
            app:destination="@id/analysisFragment" />
        <action
            android:id="@+id/action_scanner_to_detail"
            app:destination="@id/detailFragment" />
    </fragment>

    <fragment
        android:id="@+id/cameraFragment"
        android:name="vn.edu.vlu.milestone2.ui.camera.CameraFragment"
        android:label="Chụp ảnh" />

    <fragment
        android:id="@+id/analysisFragment"
        android:name="vn.edu.vlu.milestone2.ui.analysis.AnalysisFragment"
        android:label="Phân tích">
        <argument
            android:name="barcode"
            android:defaultValue=""
            app:argType="string" />
        <action
            android:id="@+id/action_analysis_to_detail"
            app:destination="@id/detailFragment" />
    </fragment>

    <fragment
        android:id="@+id/detailFragment"
        android:name="vn.edu.vlu.milestone2.ui.detail.DetailFragment"
        android:label="@string/detail_title">
        <argument
            android:name="barcode"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/recipeFragment"
        android:name="vn.edu.vlu.milestone2.ui.recipe.RecipeFragment"
        android:label="Gợi ý" />

</navigation>
